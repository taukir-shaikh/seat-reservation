PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seats
# set to true for hosted Postgres that needs TLS (Neon, Render external URL, ...)
DB_SSL=false
DB_POOL_MAX=20

# used to sign user tokens
JWT_SECRET=change-me
# required as the x-admin-key header on POST /shows
ADMIN_KEY=change-me-too

LOG_LEVEL=info
